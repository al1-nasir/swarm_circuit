{
  "name": "swarmcircuit-studio",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "next build --webpack",
    "start": "NODE_ENV=production node server.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib tests *.mjs *.json",
    "lint": "prettier --check app components lib tests *.mjs *.json",
    "test:unit": "node --experimental-strip-types tests/model.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "test:integration": "node tests/gateway.integration.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@xyflow/react": "12.12.0",
    "dotenv": "18.0.9",
    "elkjs": "0.12.1",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
