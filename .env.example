# Generate actual credentials with: make init-local
SWARM_DB_PATH=./data/swarmcircuit.db
SWARM_PROJECT_ID=11111111-1111-4111-8111-111111111111
SWARM_SDK_PROJECT_TOKEN=replace-with-a-random-sdk-token
SWARM_OPERATOR_TOKEN=replace-with-a-different-random-operator-token
SWARM_OTLP_MAX_BYTES=2097152
SWARM_WRITE_QUEUE_SIZE=128
SWARM_WRITE_TIMEOUT_SECONDS=5
SWARM_ALLOWED_ORIGINS=http://localhost:3000
# Read-only detectors. Setting interval=0 disables the timer only; ingestion still evaluates.
SWARM_DETECTOR_INTERVAL_SECONDS=1
SWARM_APPROVAL_WINDOW_MS=30000
SWARM_APPROVAL_DUPLICATE_THRESHOLD=3
SWARM_RETRY_WINDOW_MS=60000
SWARM_RETRY_RATIO_THRESHOLD=1.0
SWARM_STALL_TIMEOUT_MS=60000
# Cooperative runtime leases, fixed credential TTL, ACK deadline, and policy target bound.
SWARM_RUNTIME_HEARTBEAT_TIMEOUT_MS=15000
SWARM_RUNTIME_TOKEN_TTL_MS=1800000
SWARM_COMMAND_TIMEOUT_MS=30000
SWARM_BACKPRESSURE_LIMIT=20
# Optional simulation-only authority. make init-mock creates a separate .env.mock.
# Never reuse SDK/operator credentials here. Normal make server leaves this off.
SWARM_MOCK_BROKER_ENABLED=false
SWARM_MOCK_BROKER_TOKEN=

# Local Studio gateway (Node only; never use NEXT_PUBLIC_* for credentials).
# SWARM_API_URL=http://127.0.0.1:8000
# STUDIO_PORT=3000
# SWARM_STUDIO_READ_ONLY=true

# Optional model provider for reviewed live handoffs and CLI workload validation.
# Keys stay server-side. Offline walkthroughs make no model calls; a reviewed
# live walkthrough permits at most three calls over bundled synthetic data.
SWARM_MODEL_BASE_URL=
SWARM_MODEL_NAME=
SWARM_MODEL_API_KEY=

# Trusted loopback address used only by the managed local SDK walkthrough.
# make server sets this to its actual PORT; do not derive it from browser headers.
# SWARM_DEMO_API_URL=http://127.0.0.1:8000
